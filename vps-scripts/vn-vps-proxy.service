[Unit]
Description=VN Market VPS HTTP Proxy Server — SSC iboard geo-block workaround
Documentation=https://github.com/phamhung075/VN-Market-Intelligence-MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /root/vps-proxy-server.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/vn-vps-proxy.log
StandardError=append:/var/log/vn-vps-proxy.log

# Environment — VPS_API_KEY comes from /etc/vn-market.env
EnvironmentFile=-/etc/vn-market.env
Environment=VPS_PROXY_PORT=8765

# Resource limits
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
