[Unit]
Description=VN Market board-of-management details fetcher — Vietstock officer appointment years
Documentation=https://github.com/phamhung075/VN-Market-Intelligence-MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/fetch-board-details-loop.sh
Restart=always
RestartSec=10
StandardOutput=append:/var/log/vn-board-details.log
StandardError=append:/var/log/vn-board-details.log
# Python scraper + 33 tickers × ~2 HTTP calls each — board details lighter than AGM
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
