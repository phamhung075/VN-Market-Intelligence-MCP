[Unit]
Description=VN Market SBV/VCB FX rate proxy — push USD/VND to zenmidi MCP
Documentation=https://github.com/phamhung075/VN-Market-Intelligence-MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/fetch-sbv-loop.sh
Restart=always
RestartSec=10
StandardOutput=append:/var/log/vn-sbv-fetch.log
StandardError=append:/var/log/vn-sbv-fetch.log
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
