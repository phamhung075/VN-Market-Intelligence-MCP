[Unit]
Description=Reuters RSS proxy — push international finance news to zenmidi MCP
Documentation=https://github.com/phamhung075/VN-Market-Intelligence-MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/fetch-reuters-loop.sh
Restart=always
RestartSec=10
StartLimitIntervalSec=0
MemoryMax=512M
MemorySwapMax=0
TasksMax=32
StandardOutput=append:/var/log/vn-reuters.log
StandardError=append:/var/log/vn-reuters.log

[Install]
WantedBy=multi-user.target
