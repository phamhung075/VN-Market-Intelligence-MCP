[Unit]
Description=VN Market BCTC URL Enricher — discover PDF URLs from HOSE/HNX/UPCOM
Documentation=https://github.com/phamhung075/VN-Market-Intelligence-MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/root/enrich-bctc-urls.sh
StandardOutput=append:/var/log/vn-bctc-enrich.log
StandardError=append:/var/log/vn-bctc-enrich.log
MemoryMax=64M
TasksMax=8

[Install]
WantedBy=multi-user.target
