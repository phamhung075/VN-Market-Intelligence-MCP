r/news-analysis/intelligenceCycleJob.ts", "source_location": "L438"}, {"caller_nid": "intelligencecyclejob_defaultcomputehexagrams", "callee": "now", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L445"}, {"caller_nid": "intelligencecyclejob_defaultcomputehexagrams", "callee": "warn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L448"}, {"caller_nid": "intelligencecyclejob_defaultcomputehexagrams", "callee": "String", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L450"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "now", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L522"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "isMarketHoursFn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L530"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "getWatchlistCodesFn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L545"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "error", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L548"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "String", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L549"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "pollNewsFn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L556"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "debug", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L558"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "String", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L570"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "String", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L572"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "error", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L573"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "(async () => {\n      try {\n        const { fetchYahooFinancePrices, storeCommoditySnapshot } = await import(\"../../infrastructure/fetchers/yahooFinance.js\");\n        const commodity = await fetchYahooFinancePrices();\n        if (commodity) await storeCommoditySnapshot(commodity);\n      } catch { /* best-effort */ }\n      try {\n        const { fetchSbvRates, storeSbvSnapshot } = await import(\"../../infrastructure/fetchers/sbv.js\");\n        const sbv = await fetchSbvRates();\n        if (sbv) await storeSbvSnapshot(sbv);\n      } catch { /* best-effort */ }\n    })", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L584"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "(async () => {\n    const { getAllMacroStats } = await import(\"../../infrastructure/db/macroStatsStore.js\");\n    const { classifyDeviation } = await import(\"../../domain/services/macroThresholds.js\");\n    const { storeAlerts } = await import(\"../../infrastructure/db/alertStore.js\");\n    const { getDb: getDatabase } = await import(\"../../infrastructure/db/schema.js\");\n    const stats = getAllMacroStats();\n    const today = new Date().toISOString().slice(0, 10);\n    const nowIso = new Date().toISOString();\n    const db = getDatabase();\n    const macroAlerts: Alert[] = [];\n    for (const s of stats) {\n      // Skip usdVndOfficial \u2014 duplicates usdVndRate (same USD/VND condition, near-identical \u03c3)\n      if (s.name === \"usdVndOfficial\") continue;\n\n      const dev = classifyDeviation(s);\n      if (dev.level !== \"high\" && dev.level !== \"extreme\") continue;\n\n      // Skip if any alert for this indicator was already SENT today \u2014 prevents\n      // level-drift (e.g. extreme\u2192high) from re-firing the same condition hours later.\n      const alreadySentToday = db.prepare(\n        `SELECT 1 FROM alerts WHERE id LIKE ? AND notified_telegram = 1 LIMIT 1`\n      ).get(`macro-${today}-${dev.name}-%`) as { 1: number } | undefined;\n      if (alreadySentToday) continue;\n\n      const severity = dev.level === \"extreme\" ? \"critical\" : \"high\";\n      macroAlerts.push({\n        id: `macro-${today}-${dev.name}-${dev.level}`,\n        actionCode: \"MACRO\",\n        signals: [{\n          actionCode: \"MACRO\",\n          type: \"macro_deviation\",\n          severity,\n          message: dev.summary,\n          timestamp: nowIso,\n        // biome-ignore lint/suspicious/noExplicitAny: Signal type cross-imported\n        } as any],\n        severity,\n        message: `Macro alert [${dev.level.toUpperCase()}]: ${dev.summary}`,\n        isRead: false,\n        createdAt: nowIso,\n      });\n    }\n    if (macroAlerts.length > 0) {\n      storeAlerts(macroAlerts, db);\n      logger.info(\"[intelligence-cycle] step A2.5 \u2014 macro alerts persisted\", {\n        count: macroAlerts.length,\n        ids: macroAlerts.map((a) => a.id),\n      });\n    }\n    })", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L610"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "warn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L661"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "String", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L662"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "(async () => {\n      const { syncVnstockData } = await import(\"../../application/usecases/syncVnstockData.js\");\n      const { getDb: getDatabase } = await import(\"../../infrastructure/db/schema.js\");\n      const watchlistRows = getDatabase()\n        .prepare(\"SELECT code FROM watchlist\")\n        .all() as Array<{ code: string }>;\n      const codes = watchlistRows.map((r: { code: string }) => r.code);\n      if (codes.length > 0) {\n        await syncVnstockData(codes);\n      }\n    })", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L669"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "debug", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L686"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "getWatchlistCodesFn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L691"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "debug", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L694"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "computeHexagramsFn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L699"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "debug", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L703"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "warn", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L711"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "String", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L712"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "slice", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L720"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "toISOString", "source_file": "src/scheduler/news-analysis/intelligenceCycleJob.ts", "source_location": "L720"}, {"caller_nid": "intelligencecyclejob_runcycle", "callee": "map", "source_fil