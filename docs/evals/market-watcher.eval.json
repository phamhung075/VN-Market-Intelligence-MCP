            "signal_type": "price_anomaly",
            "stock_code": "HPG",
            "finding_data": {
              "required_fields": {
                "move_pct": -3.0,
                "move_sigma": 2.0
              },
              "optional_fields_if_present": {
                "regime": "TIGHTENING",
                "adjusted_threshold": "1.5σ",
                "fx_pressure": false,
                "pe_compression_risk": false
              }
            },
            "priority_escalated": true,
            "escalated_priority": "HIGH"
          }
        ],
        "session_log_contains": [
          "Regime: TIGHTENING",
          "DXY: USD STRENGTHENING",
          "US10Y: RISK-OFF"
        ]
      },

      "assertions": [
        {
          "id": "MW-002-A1",
          "description": "TIGHTENING sets sigma_threshold to 1.5σ",
          "rule": "sigma_threshold == 1.5",
          "blocking": true
        },
        {
          "id": "MW-002-A2",
          "description": "move_pct must be negative (downside move)",
          "rule": "finding_data.move_pct < 0",
          "blocking": true
        },
        {
          "id": "MW-002-A3",
          "description": "downside_bias=true in TIGHTENING must escalate negative move priority MEDIUM→HIGH or LOW→MEDIUM",
          "rule": "priority_escalated == true",
          "blocking": true
        },
        {
          "id": "MW-002-A4",
          "description": "volume spike >1.5x avg in TIGHTENING regime must be noted in session log",
          "rule": "session_log contains 'Volume spikes: 1'",
          "blocking": false
        }
      ]
    },

