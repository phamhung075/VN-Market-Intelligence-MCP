        "get_sector_comparison_HPG": {
          "code": "HPG",
          "result": {
            "sector": "steel",
            "sector_return_1d": -1.2,
            "stock_return_1d": -3.0,
            "outperformance": -1.8
          }
        },
        "get_technical_indicators_HPG": {
          "ticker": "HPG",
          "result": {
            "rsi": 32,
            "macd": { "line": -180, "signal": -90, "histogram": -90 },
            "bollinger_bands": { "upper": 27000, "middle": 25200, "lower": 23400 },
            "signal_strength": "strong"
          }
        }
      },

      "derived_values": {
        "REGIME": "TIGHTENING",
