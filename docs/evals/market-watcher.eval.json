  "cases": [

    {
      "id": "MW-001",
      "name": "NEUTRAL regime — single stock >2σ upside move → price_anomaly posted",
      "description": "Stock VCB moves +3.2% in a NEUTRAL macro regime (sigma_threshold=2.0). Move computes to 2.67σ. Signal must be posted with required fields.",

      "mock_inputs": {
        "get_cycle_bootstrap": {
          "agent_name": "market-watcher",
          "market_context": {
            "trading_window": "open",
            "mcpServerHealth": "UP",
            "macro_snapshot_text": "Global Liquidity: NEUTRAL | VND Carry Spread: NEUTRAL | US 10Y Yield: RISK-ON | DXY: USD STABLE"
          },
          "agent_signals": []
        },
        "get_price_history_VCB": {
          "tickers": ["VCB"],
          "days": 30,
          "result": {
            "VCB": {
              "today_close": 93600,
              "prev_close": 90700,
              "daily_std_dev_fraction": 0.012,
              "ma20": 89500,
              "ma50": 88000,
              "trend": "uptrend",
              "volume_today": 4200000,
              "volume_avg_20d": 3800000
            }
          }
        },
        "get_sector_comparison_VCB": {
          "code": "VCB",
          "result": {
            "sector": "banking",
            "sector_return_1d": 0.8,
            "stock_return_1d": 3.2,
            "outperformance": 2.4
          }
        },
        "get_technical_indicators_VCB": {
          "ticker": "VCB",
          "result": {
            "rsi": 58,
            "macd": { "line": 320, "signal": 210, "histogram": 110 },
            "bollinger_bands": { "upper": 95000, "middle": 89500, "lower": 84000 },
            "signal_strength": "moderate"
          }
        }
      },

      "derived_values": {
        "REGIME": "NEUTRAL",
        "sigma_threshold": 2.0,
        "volume_multiplier": 2.0,
        "downside_bias": false,
        "price_change_pct": 3.2,
        "move_sigma_computed": 2.67,
        "volume_ratio": 1.11
      },

      "expected_output": {
        "signals_posted": [
          {
            "from_agent": "market-watcher",
            "to_agent": "alert-commander",
            "signal_type": "price_anomaly",
            "stock_code": "VCB",
            "payload": {
              "title_pattern": "VCB +3.20% (2.67σ)",
              "detail_contains": ["VCB", "3.2%", "NEUTRAL"]
            },
            "finding_data": {
              "required_fields": {
                "move_pct": 3.2,
                "move_sigma": 2.67
              },
              "optional_fields_if_present": {
                "regime": "NEUTRAL",
                "adjusted_threshold": "2.0σ",
                "fx_pressure": false,
                "pe_compression_risk": false
              }
            },
            "ttl_minutes": 120,
            "chain_depth": 0
          }
        ],
        "session_log_contains": [
          "Regime: NEUTRAL",
          "DXY: USD STABLE",
          "US10Y: RISK-ON",
          "Anomalies: 1"
        ],
        "work_channel_message_contains": ["market-watcher", "stocks monitored"]
      },

      "assertions": [
        {
          "id": "MW-001-A1",
          "description": "move_pct must be present and equal to the signed price change percentage",
          "rule": "finding_data.move_pct == price_change_pct",
          "blocking": true
        },
        {
          "id": "MW-001-A2",
          "description": "move_sigma must be abs(price_change_pct) / (dailyStdDev * 100)",
          "rule": "abs(finding_data.move_sigma - abs(price_change_pct) / (daily_std_dev_fraction * 100)) < 0.01",
          "blocking": true
        },
        {
          "id": "MW-001-A3",
          "description": "signal must be posted when move_sigma >= sigma_threshold (2.0 in NEUTRAL)",
          "rule": "signal_posted == true",
          "blocking": true
        },
        {
          "id": "MW-001-A4",
          "description": "session log must record regime and anomaly count",
          "rule": "session_log contains 'Regime: NEUTRAL' AND 'Anomalies: 1'",
          "blocking": true
        }
      ]
    },

    {
