  "schema_assertions": {
    "PriceAnomalyFindingData": {
      "required": ["move_pct", "move_sigma"],
      "optional": ["ref_price", "window_days", "price_change_pct", "regime", "adjusted_threshold", "fx_pressure", "pe_compression_risk"],
      "passthrough": true,
      "validation_rules": [
        "move_pct: number (signed)",
        "move_sigma: number (positive)",
        "window_days: integer >= 1 if present",
        "fx_pressure: boolean if present",
        "pe_compression_risk: boolean if present"
      ]
    },
    "PriceConfirmationFindingData": {
      "required": ["price_change_pct", "volume_ratio", "confirms_direction", "fully_priced", "confidence"],
      "optional": ["catalyst_stock_code", "catalyst_direction", "time_to_price_move"],
      "validation_rules": [
        "volume_ratio: number >= 0",
        "confidence: number [0.0, 1.0]",
        "confirms_direction: boolean",
        "fully_priced: boolean"
      ]
    }
  },

  "threshold_matrix": {
    "description": "Adaptive thresholds derived from macro regime — zero extra tool calls",
    "regimes": {
      "TIGHTENING": {
        "sigma_threshold": 1.5,
        "volume_multiplier": 1.5,
        "downside_bias": true
      },
      "EASING": {
        "sigma_threshold": 2.5,
        "volume_multiplier": 2.5,
        "downside_bias": false
      },
      "NEUTRAL": {
        "sigma_threshold": 2.0,
        "volume_multiplier": 2.0,
        "downside_bias": false
      }
    }
  },

  "flag_rules": {
    "fx_pressure": {
      "condition": "DXY_SIGNAL == 'USD STRENGTHENING' AND sector in ['banking', 'realty']",
      "field": "fx_pressure",
      "value": true
