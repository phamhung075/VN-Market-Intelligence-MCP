    "channels": [
      {
        "id": "market",
        "env_var": "TELEGRAM_MARKET_CHAT_ID",
        "purpose": "user-facing chef dishes (narrative synthesis), event alerts, weekly calibration, /ask answers",
        "allowed_senders": [
          "unified-agent",
          "alert-commander",
          "digest-predict",
          "qa-responder"
        ],
        "sender_rules": {
          "unified-agent": "Chef — 3 guaranteed daily dishes (Morning 05:23/EOD 08:37/Evening 19:37 UTC) + conditional intraday. Narrative 2-4 paragraphs. TNB 6-layer walk.",
          "alert-commander": "Event-only — position-danger (3-condition) or watchlist-opportunity (4-condition) ONLY. ≤140 chars. Silent exit otherwise.",
          "digest-predict": "Weekly Sunday 13:47 UTC calibration + portfolio thesis only. No daily digest.",
          "qa-responder": "/ask FIFO queue replies only."
        },
        "rules": [
          "NEVER send errors/status/heartbeats here",
          "Only actionable content",
          "market-watcher REMOVED as sender — writes docs/signals/ only"
        ]
      },
      {
        "id": "work",
        "env_var": "TELEGRAM_WORK_CHAT_ID",
        "purpose": "agent cycle status, heartbeats, quality reports",
        "allowed_senders": [
          "all"
        ],
        "format": "[Agent Name] HH:MM UTC — summary"
      },
      {
        "id": "bug",
        "env_var": "TELEGRAM_BUG_CHAT_ID",
        "purpose": "errors, failures, incidents",
        "allowed_senders": [
          "all"
        ],
        "rules": [
          "Check get_recent_fixes(limit=20) before sending — skip if already fixed",
          "Format: [Agent] SEVERITY\\nIssue: ... | Impact: ... | Status: ..."
        ]
      }
    ],
