# ── VN Market Intelligence MCP — Environment ───────────────────────────────
# Copy to .env and fill in your values

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info           # debug | info | warn | error

# Data paths (relative to project root)
DATA_DIR=./data
DB_PATH=./data/market.db
LANCEDB_PATH=./data/lancedb
REPORTS_DIR=./data/reports

# Embedding model (downloaded automatically on first run, ~400MB)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./data/models

# Alert defaults
DEFAULT_ALERT_DROP_PCT=-3       # alert if price drops more than 3%
DEFAULT_ALERT_RISE_PCT=5        # alert if price rises more than 5%
DEFAULT_IMPACT_SCORE_MIN=7      # alert if AI impact score >= 7/10

# Scheduler (cron expressions, GMT+7)
CRON_MORNING_BRIEFING=0 8 * * *
CRON_MARKET_OPEN=0 9 * * 1-5
CRON_NEWS_POLL=*/30 * * * *
CRON_MARKET_CLOSE=30 15 * * 1-5
CRON_SSC_CHECK=0 20 * * *
CRON_EVENING_SUMMARY=0 22 * * *

# Sources — optional API keys
TRADING_ECONOMICS_API_KEY=
