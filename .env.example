# ── VN Market Intelligence MCP — Environment ───────────────────────────────
# Copy to .env and fill in your values

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info           # debug | info | warn | error

# Data paths (relative to project root)
DATA_DIR=./data
DB_PATH=./data/market.db
LANCEDB_PATH=./data/lancedb
REPORTS_DIR=./data/reports

# Embedding model (downloaded automatically on first run, ~400MB)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./data/models

# Alert defaults
DEFAULT_ALERT_DROP_PCT=-3       # alert if price drops more than 3%
DEFAULT_ALERT_RISE_PCT=5        # alert if price rises more than 5%
DEFAULT_IMPACT_SCORE_MIN=7      # alert if AI impact score >= 7/10

# Scheduler (cron expressions, GMT+7)
CRON_MORNING_BRIEFING=0 8 * * *
CRON_MARKET_OPEN=0 9 * * 1-5
CRON_NEWS_POLL=*/30 * * * *
CRON_MARKET_CLOSE=30 15 * * 1-5
CRON_SSC_CHECK=0 20 * * *
CRON_EVENING_SUMMARY=0 22 * * *

# Sources — optional API keys
TRADING_ECONOMICS_API_KEY=

# BCTC enrichment — geo-blocked sources (France → VPS proxy)
# iboard-query.ssc.vn is NXDOMAIN outside Vietnam.
# VPS proxy server: vps-scripts/vps-proxy-server.js (systemd vn-vps-proxy.service, port 8765).
# docker-compose.yml sets this automatically — only override here for local dev.
# Leave unset to use the direct domain (only works on Vietnam IPs).
SSC_IBOARD_BASE_URL=http://125.212.251.27:8765/proxy/ssc-iboard

# VPS SSH access — used by restart_vps_service MCP tool (sshExec.ts).
# VPS_HOST: IP of the Vinahost VPS (Vietnam, bypasses geo-block).
# VPS_SSH_USER: SSH login user on the VPS (typically root).
# VPS_SSH_KEY_PATH: path to private key inside the container.
#   docker-compose.yml mounts ~/.ssh/id_rsa → /run/secrets/vps_ssh_key by default.
#   Set a different value only if your key filename differs.
VPS_HOST=125.212.251.27
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=/run/secrets/vps_ssh_key

# VPS BCTC discovery — API key for vn-vps-proxy.service auth (port 8765)
# Required for bctcHttpFetcher.ts to inject X-API-Key on VPS-targeted requests.
# Without this, /proxy/bctc-discover/:ticker returns HTTP 401.
# Match the value set in vps-scripts/vps-proxy-server.js VALID_API_KEYS.
VPS_PUSH_API_KEY=

# BCTC hsx.vn Strategy 0 gate
HSX_BCTC_ENABLED=true   # set to false to skip hsx.vn Strategy 0 (undocumented API)
