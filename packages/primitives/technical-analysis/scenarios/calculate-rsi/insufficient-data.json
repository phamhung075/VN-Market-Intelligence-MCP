{
  "_meta": {
    "primitive": "calculateRSI",
    "scenario": "insufficient-data",
    "description": "Edge case: prices.length <= period → empty array returned. Tests multiple sub-threshold lengths.",
    "rule": "prices.length must be > period to produce at least one RSI value. With period=14, need ≥15 prices."
  },
  "cases": [
    {
      "description": "Exactly period prices (14 prices, period=14) → empty",
      "input": {
        "prices": [50, 51, 52, 51, 53, 54, 53, 55, 54, 56, 55, 57, 56, 58],
        "period": 14
      },
      "expected": {
        "rsiSeries": [],
        "length": 0
      }
    },
    {
      "description": "Period - 1 prices (13 prices, period=14) → empty",
      "input": {
        "prices": [50, 51, 52, 51, 53, 54, 53, 55, 54, 56, 55, 57, 56],
        "period": 14
      },
      "expected": {
        "rsiSeries": [],
        "length": 0
      }
    },
    {
      "description": "Single price (1 price, period=14) → empty",
      "input": {
        "prices": [50],
        "period": 14
      },
      "expected": {
        "rsiSeries": [],
        "length": 0
      }
    },
    {
      "description": "Empty array (0 prices, period=14) → empty",
      "input": {
        "prices": [],
        "period": 14
      },
      "expected": {
        "rsiSeries": [],
        "length": 0
      }
    },
    {
      "description": "Exactly period+1 prices (15 prices, period=14) → one RSI value",
      "input": {
        "prices": [50, 50.5, 50.2, 51, 52.2, 51.7, 52, 51.2, 51.8, 52, 51.6, 52.3, 52.1, 53, 53.4],
        "period": 14
      },
      "expected": {
        "rsiSeries": [71.794872],
        "length": 1
      }
    }
  ]
}
