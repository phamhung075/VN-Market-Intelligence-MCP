{
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "name": "vn-market-intelligence",
    "version": "1.0.0",
    "logLevel": "info"
  },

  "logging": {
    "maxFileSizeMb": 50,
    "lancedbLevel": "warn"
  },

  "data": {
    "dbPath": "./data/market.db",
    "lancedbPath": "./data/lancedb",
    "briefingsDir": "./data/briefings",
    "reportsDir": "./data/reports"
  },

  "embedding": {
    "model": "Xenova/paraphrase-multilingual-MiniLM-L12-v2",
    "cacheDir": "./data/models",
    "dimensions": 384,
    "maxTextLength": 2000
  },

  "telegram": {
    "botToken": "",
    "marketGroupId": "",
    "workChannelId": "",
    "bugChannelId": "",
    "parseMode": "Markdown",
    "enabled": false
  },

  "market": {
    "timezone": "Asia/Ho_Chi_Minh",
    "utcOffset": 7,
    "openTime": "09:00",
    "closeTime": "15:30",
    "tradingDays": [1, 2, 3, 4, 5],
    "watchlist": [
      "VCB", "BID", "SHB", "EIB",
      "VHM", "VIC", "KBC", "HUT", "DIG", "DXG", "KDH", "PDR", "NVL", "VRE",
      "HPG",
      "MSN", "FRT", "KDC",
      "SAB",
      "FPT",
      "VNM", "VEA", "DPM",
      "SSI", "VIX", "VND", "VCI",
      "DGC",
      "VJC",
      "GEX",
      "BSR",
      "PLX"
    ],
    "referenceStocks": {
      "banking":       ["VCB", "BID", "CTG", "TCB", "MBB", "VPB", "ACB", "SHB", "EIB", "STB", "HDB", "TPB"],
      "real_estate":   ["VIC", "VHM", "VRE", "NVL", "KDH", "DXG", "NLG", "PDR", "KBC", "DIG", "HDG", "DFF"],
      "steel":         ["HPG", "HSG", "NKG", "TIS", "POM"],
      "oil_gas":       ["GAS", "PLX", "BSR", "PVD", "PVS", "OIL"],
      "aviation":      ["HVN", "VJC", "ACV", "SCS"],
      "retail":        ["MWG", "VNM", "MSN", "FRT", "KDC", "DGW", "PNJ", "SAB"],
      "tech":          ["FPT", "CMG", "ELC", "SAM"],
      "securities":    ["SSI", "VND", "VIX", "VCI", "HCM", "SHS", "MBS"],
      "utilities":     ["GEX", "REE", "PC1", "POW", "GEG", "BCG", "NT2"],
      "agriculture":   ["DPM", "VHC", "ANV", "HAG", "HNG", "ASM", "DBC"],
      "insurance":     ["BVH", "PVI", "BMI", "MIG"],
      "logistics":     ["GMD", "VTP", "VOS", "STG", "HAH"],
      "gold_mining":   ["PNJ"],
      "automotive":    ["VEA", "HAX", "CTF", "TMT", "SMA"],
      "construction":  ["HHV", "CTD", "VCG", "HBC", "FCN", "HUT"],
      "energy":        ["GEG", "REE", "PC1", "BCG"],
      "pharmaceutical":["DHG", "IMP", "DMC", "DBD", "PME", "TRA", "OPC"],
      "chemicals":     ["DGC"],
      "other":         []
    },
    "globalIndices": {
      "SP500":      "^GSPC",
      "DJIA":       "^DJI",
      "NASDAQ":     "^IXIC",
      "NIKKEI":     "^N225",
      "SHANGHAI":   "000001.SS",
      "HANGSENG":   "^HSI",
      "KOSPI":      "^KS11",
      "FTSE100":    "^FTSE",
      "DAX":        "^GDAXI",
      "CAC40":      "^FCHI",
      "ASX200":     "^AXJO"
    }
  },

  "predictionMarkets": {
    "enabled": true,
    "pollingIntervalMinutes": 30,
    "clobApiUrl": "https://clob.polymarket.com",
    "gammaApiUrl": "https://gamma-api.polymarket.com",
    "probabilityShiftPct": 5,
    "volumeSpikeThresholdUsd": 50000,
    "minUniqueWallets": 10,
    "whaleTradeThresholdUsd": 10000,
    "maxMarketsPerPoll": 50,
    "rateLimitDelayMs": 500,
    "relevantKeywords": [
      "fed", "china", "oil", "tariff", "asean", "vietnam",
      "interest rate", "war", "sanctions", "trade", "inflation", "currency"
    ],
    "curatedMarketIds": [],
    "staleThresholdHours": 24
  },

  "alerts": {
    "defaultDropPct": -3,
    "defaultRisePct": 5,
    "defaultImpactScoreMin": 7.5,
    "volumeSpikeMultiplier": 2,
    "reportFreshHours": 24,
    "severityEscalation": {
      "signalsForHigh": 2,
      "signalsForCritical": 3
    },
    "newsMention": {
      "maxAgeMinutes": 240,
      "requireNonNeutralSentiment": true,
      "minSentimentConfidence": 0.5,
      "minCascadeConfidence": 0.85,
      "highTrustSources": ["cafef", "vnexpress", "vneconomy"]
    },
    "telegramOnSeverity": ["high", "critical"],
    "telegramOnNewDocument": true,
    "telegramMinCascadeConfidence": 0.85,
    "marketWideCascadeMinImpact": 6,
    "domainThresholds": {
      "banking":      { "dropPct": -4, "risePct": 6 },
      "oil_gas":      { "dropPct": -5, "risePct": 7 },
      "aviation":     { "dropPct": -4, "risePct": 6 },
      "retail":       { "dropPct": -3, "risePct": 5 },
      "tech":         { "dropPct": -5, "risePct": 8 },
      "steel":        { "dropPct": -5, "risePct": 7 },
      "real_estate":  { "dropPct": -4, "risePct": 6 }
    }
  },

  "fetchers": {
    "httpTimeoutMs": 15000,
    "ssc": {
      "url": "https://congbothongtin.ssc.gov.vn/faces/NewsSearch",
      "chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "pageTimeoutMs": 30000,
      "selectorTimeoutMs": 15000,
      "inputDelayMs": 80,
      "resultsWaitMs": 5000,
      "downloadWaitMs": 5000,
      "headless": true
    },
    "hose": {
      "apiBase": "https://finfo-api.vndirect.com.vn/v4",
      "maxPageSize": 100,
      "avgVolumeWindow": 20
    },
    "hnx": {
      "apiBase": "https://api.hnx.vn/api/snapshot"
    },
    "rss": {
      "cafef": "https://cafef.vn/thi-truong-chung-khoan.rss",
      "vnexpress": "https://vnexpress.net/rss/kinh-doanh.rss",
      "reuters": "https://news.google.com/rss/search?q=vietnam+economy+OR+stock+market&hl=en",
      "apNews": "https://news.google.com/rss/search?q=asia+finance+OR+emerging+markets&hl=en",
      "vneconomyStocks": "https://vneconomy.vn/chung-khoan.rss",
      "vneconomyFinance": "https://vneconomy.vn/tai-chinh.rss"
    },
    "tradingEconomics": {
      "baseUrl": "https://tradingeconomics.com",
      "indicatorsPath": "/vietnam/indicators"
    },
    "yahooFinance": {
      "apiUrl": "https://query1.finance.yahoo.com/v8/finance/chart",
      "symbols": {
        "brentCrude": "BZ=F",
        "gold": "GC=F",
        "usdVnd": "USDVND=X"
      }
    },
    "sbv": {
      "vcbRatesUrl": "https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx?b=68",
      "fallbackOvernightRate": 3.0,
      "fallbackRefinancingRate": 4.5
    },
    "rateLimits": {
      "cafef.vn": 8000,
      "vnexpress.net": 8000,
      "vneconomy.vn": 8000,
      "news.google.com": 8000,
      "api-finfo.vndirect.com.vn": 5000,
      "api.hnx.vn": 5000,
      "query1.finance.yahoo.com": 5000,
      "tradingeconomics.com": 10000,
      "portal.vietcombank.com.vn": 10000,
      "clob.polymarket.com": 10000,
      "gamma-api.polymarket.com": 10000
    }
  },

  "cycle": {
    "warnThresholdMinutes": 12,
    "offHoursIntervalMinutes": 60,
    "maxConcurrent": 1
  },

  "alertQuality": {
    "cooldownMinutes": 30,
    "maxAlertsPerStockPerDay": 3,
    "dedupWindowMinutes": 60,
    "groupWindowMinutes": 15,
    "neverSuppressSeverity": ["critical"],
    "macroCooldownMinutes": 360
  },

  "adaptiveThresholds": {
    "enabled": true,
    "windowDays": 20,
    "dropSigma": 2.0,
    "riseSigma": 2.0,
    "volumeSigma": 2.0,
    "minDropPct": -1,
    "maxDropPct": -15,
    "minRisePct": 1,
    "maxRisePct": 15,
    "minVolumeMult": 1.5,
    "maxVolumeMult": 5.0
  },

  "rag": {
    "temporalDecay": {
      "enabled": true,
      "halfLifeDays": 7,
      "maxBoost": 0.3
    },
    "decayHalfLifeDays": {
      "news":     2,
      "macro":    7,
      "filing":   30,
      "analysis": 14
    },
    "maxDistance": 0.9
  },

  "fetchLimits": {
    "marketHours": {
      "newsPerSource": 5,
      "totalNews": 15
    },
    "prePostMarket": {
      "newsPerSource": 10,
      "totalNews": 30
    },
    "offHours": {
      "newsPerSource": 15,
      "totalNews": 40
    },
    "manual": {
      "newsPerSource": 20,
      "totalNews": 50
    }
  },

  "circuitBreaker": {
    "failureThreshold": 5,
    "resetTimeoutMs": 60000,
    "halfOpenMaxAttempts": 2
  },

  "alertPolicy": {
    "positionDanger": {
      "singleDayDropPct": 5,
      "newsSentimentBelow": -0.5,
      "requireAllConditions": true
    },
    "watchlistOpportunity": {
      "kinhDichConfidenceMin": 70,
      "kinhDichSignalMustBe": "BUY",
      "newsSentimentMin": 0.3,
      "agentSignalsMajority": "BUY"
    },
    "alertCooldownMinutes": 0
  },

  "features": {
    "disableSscPolling": true
  },

  "fallbacks": {
    "enableDomesticNewsFallback": false,
    "enableCongbaoFallback": false,
    "congbaoMinVpsOpenMinutes": 120,
    "thresholds": {
      "news": 15,
      "prices": 10,
      "bctc": 360,
      "sbv_rates": 120,
      "foreign_flow": 60
    }
  },

  "newsSources": {
    "newsapi": {
      "apiKey": "",
      "enabled": false
    },
    "marketwatch": {
      "enabled": true
    }
  },

  "deepFetch": {
    "maxPerCycle": 10,
    "maxPlaywrightPerCycle": 5,
    "staleExpiryHours": 4,
    "domainDailyCap": {
      "cafef.vn": 50,
      "vneconomy.vn": 30,
      "vnexpress.net": 40
    },
    "playwrightAllowedDomains": [
      "vietstock.vn",
      "vietnambiz.vn",
      "vnbusiness.vn",
      "reuters.com",
      "bloomberg.com"
    ]
  }
}
