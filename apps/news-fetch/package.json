{
  "name": "news-fetch",
  "version": "1.0.0",
  "description": "News Fetch microservice — Reuters/Bloomberg headlines (DDD, port 5008)",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "check": "bun tsc --noEmit",
    "sandbox": "bun run src/sandbox/runner.ts"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.11",
    "typescript": "^5.4.0"
  }
}
