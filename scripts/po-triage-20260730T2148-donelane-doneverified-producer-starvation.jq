def annot($id; $key; $val):
  (.task_board.backlog, .task_board.ready, .task_board.in_progress,
   .task_board.review, .task_board.qa, .task_board.done)
  |= map(if (.id // .task_id) == $id then . + {($key): $val} else . end);

