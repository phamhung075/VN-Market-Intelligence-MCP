#!/usr/bin/env bash
# Pre-push hook: run tsc --noEmit via pnpm workspace filter to catch the
# "tracked code imports untracked files" class of bug that bit Loop #20
# Slice 1 (kinhDich domain files were imported by tracked code but never
# committed, breaking main on every fresh clone / launchd restart).
#
# BUG-FIX (1873f): The original hook ran `bun tsc --noEmit` from REPO ROOT
# where tsconfig.json has `"include":["src/**/*"]` but no /src/ exists at
# root → tsc compiled 0 files and exited 0 (phantom OK). Fixed by delegating
# to `pnpm --filter vn-market check` which runs tsc from apps/mcp-server
# where tsconfig.json is valid and src/ exists.
#
# PATH-FILTER (UC-GCP-P4, 2026-07-16): the full tsc alone measures ~94s wall-
# clock — longer than the commit-mutex TTL=90s — so EVERY push (even a
# doc/notebook/orch-state-only push, ~68% of commits) held the mutex past
# expiry and let a peer task_claim win mid-push. Skip the tsc when the push
# range touches no code path. Code-touching set: apps/**, packages/**,
# scripts/**/*.{ts,tsx,js,mjs,json} plus root package.json / pnpm-lock.yaml /
# pnpm-workspace.yaml (dependency changes affect tsc). docs/ is excluded.
# Fail-open: any `git diff` failure (remote sha absent locally) or a brand-new
# branch (zero remote sha) always runs the FULL tsc — never skips.
#
# RAW-VERIFY GUARDRAIL (FACTORY-GUARD-CI-RAWVERIFY-IMPL, 2026-07-30): reuses
# this same CODE_TOUCHING_REGEX-gated per-ref diff to also call
# scripts/audits/rebuild-raw-verify-check.sh <remote_sha> <local_sha> — blocks
# (BLOCKING, primary — this repo has no PR/branch-protection to gate on, see
# docs/architecture-briefs/2026-07-24-factory-guard-ci-rebuild-raw-verify-hook.md
# §0) a push that touches a DB-write/route-serving DDD layer with an
# un-attested confidence/score/impact/magnitude/probability field addition —
# see PUSH-AUTONOMY-1 §5 (docs/policies/dev-standards.md). Only invoked when
# this ref's diff was successfully computed AND matched CODE_TOUCHING_REGEX
# (same fail-open-on-diff-error posture as the tsc check above — a new-branch
# or diff-error ref skips the call rather than blocking on an undiffable range;
# the check script itself also fails open on zero-SHA/undiffable input as
# defense-in-depth for its OTHER caller, the CI backstop job).
#
# Install: ./scripts/git-hooks/install.sh  (symlinks into .git/hooks/)
# Bypass (NOT recommended, equivalent to --no-verify which is forbidden):
#   PRE_PUSH_SKIP_TSC=1 git push

set -e

if [ "${PRE_PUSH_SKIP_TSC:-0}" = "1" ]; then
  echo "[pre-push] PRE_PUSH_SKIP_TSC=1 — skipping tsc check (NOT recommended)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "[pre-push] WARN: pnpm not on PATH — skipping tsc check"
  exit 0
fi

ZERO_SHA="0000000000000000000000000000000000000000"
# apps/**, packages/**, scripts/**/*.{ts,tsx,js,mjs,json} (docs/ excluded), OR
# root package.json / pnpm-lock.yaml / pnpm-workspace.yaml (dep changes affect tsc).
CODE_TOUCHING_REGEX='^(apps|packages|scripts)/.*\.(ts|tsx|js|mjs|json)$|^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml)$'

needs_tsc=0
# shellcheck disable=SC2034  # remote_ref documents the 4-field stdin protocol; unused by design
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue

  # Branch delete: local sha is all-zeros — nothing being pushed, skip this line.
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  # New branch / no upstream (zero remote sha) — no diff base to compute, run FULL tsc.
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    echo "[pre-push] new branch (no remote sha) on $local_ref — full tsc required"
    needs_tsc=1
    continue
  fi

  # Fail-open (a): guard the diff so a non-zero exit (e.g. remote sha not present
  # locally) never hits the bare `set -e` abort — route straight to full tsc instead.
  if ! changed_paths="$(git diff --name-only "${remote_sha}..${local_sha}" 2>/dev/null)"; then
    echo "[pre-push] WARN: git diff failed for ${remote_sha}..${local_sha} — fail-open to full tsc"
    needs_tsc=1
    continue
  fi

  if printf '%s\n' "$changed_paths" | grep -qE "$CODE_TOUCHING_REGEX"; then
    needs_tsc=1

    if ! bash "$REPO_ROOT/scripts/audits/rebuild-raw-verify-check.sh" "$remote_sha" "$local_sha"; then
      echo ""
      echo "[pre-push] BLOCKED: rebuild-raw-verify-check failed for ${remote_sha}..${local_sha} on $local_ref."
      echo "[pre-push] See docs/policies/dev-standards.md PUSH-AUTONOMY-1 §5 — attest with a RAW-verify"
      echo "[pre-push] commit-message token, a raw-verify-allow: <reason> inline annotation, or a"
      echo "[pre-push] docs/agent-memory/decisions/**|reports/TASK_REPORT_*.md entry, then re-run 'git push'."
      exit 1
    fi
  fi
done

if [ "$needs_tsc" = "0" ]; then
  echo "[pre-push] no code paths in range — skipping tsc"
  exit 0
fi

echo "[pre-push] running: pnpm --filter vn-market check (tsc from apps/mcp-server)"
if ! pnpm --filter vn-market check; then
  echo ""
  echo "[pre-push] BLOCKED: tsc failed in apps/mcp-server."
  echo "[pre-push] Common cause: tracked code imports a file you forgot to 'git add'."
  echo "[pre-push] Fix the errors above, then re-run 'git push'."
  exit 1
fi

echo "[pre-push] tsc OK"
exit 0
