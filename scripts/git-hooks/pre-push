#!/usr/bin/env bash
# Pre-push hook: run `bun tsc --noEmit` to catch the "tracked code imports
# untracked files" class of bug that bit Loop #20 Slice 1 (kinhDich domain
# files were imported by tracked code but never committed, breaking main
# on every fresh clone / launchd restart).
#
# Install: ./scripts/git-hooks/install.sh  (symlinks into .git/hooks/)
# Bypass (NOT recommended, equivalent to --no-verify which is forbidden):
#   PRE_PUSH_SKIP_TSC=1 git push

set -e

if [ "${PRE_PUSH_SKIP_TSC:-0}" = "1" ]; then
  echo "[pre-push] PRE_PUSH_SKIP_TSC=1 — skipping tsc check (NOT recommended)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v bun >/dev/null 2>&1; then
  echo "[pre-push] WARN: bun not on PATH — skipping tsc check"
  exit 0
fi

echo "[pre-push] running: bun tsc --noEmit"
if ! bun tsc --noEmit; then
  echo ""
  echo "[pre-push] BLOCKED: bun tsc --noEmit failed."
  echo "[pre-push] Common cause: tracked code imports a file you forgot to 'git add'."
  echo "[pre-push] Fix the errors above, then re-run 'git push'."
  exit 1
fi

echo "[pre-push] tsc OK"
exit 0
