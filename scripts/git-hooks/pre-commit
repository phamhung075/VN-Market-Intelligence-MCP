        echo "$msg" >&2
        all_msgs="${all_msgs}${msg}
"
        rc=1
      else
        msg="[notebook-uuid-provenance-guard] WARN (ambiguous, never hard-blocked — see hook header comment): ${f} — added heading's first token '${payload}' is a bare 6-8 hex-char string, the exact shape of a truncated session-UUID fragment (confirmed live: '## ad265f86 · ...', commit 9b27e9723). If intentional (e.g. a genuine short-SHA source label), add 'notebook-uuid-lint-allow: <reason>' on this line. Otherwise use a c<NNN> counter or a fixed non-hex source label per .claude/skills/notebook-write/SKILL.md AC-1. Line: '${line}'."
        echo "$msg" >&2
        all_msgs="${all_msgs}${msg}
"
      fi
    done <<ADDEDLINES
$added_lines
ADDEDLINES
  done <<NBFILES
$nb_files
NBFILES

  [ -n "$all_msgs" ] && write_signal "$all_msgs"

  [ "$rc" -eq 1 ] && [ "$mode_uuid" != "reject" ] && return 0
  return $rc
}

