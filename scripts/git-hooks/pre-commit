#!/usr/bin/env bash
# Pre-commit hook: commit-path peer-index sweep guard (Layer 0, universal backstop).
#
# TASK: FIX-COMMIT-PATH-PEER-INDEX-SWEEP-GUARD-HOOK (docs/data/orch/orch-state.json
#       .task_board, P0). Parent: FIX-COMMIT-PATH-PEER-INDEX-SWEEP-GUARD.
# SPEC: docs/architecture-briefs/2026-07-21-commit-path-peer-index-sweep-guard.md §4.1/§4.3
# VERIFY: scripts/audits/verify-commit-sweep-discriminator.sh (re-run before trusting this
#         hook on a new git version — the discriminator depends on git-internal
#         `next-index-<pid>.lock` naming, not a documented public API).
#
# BUG THIS PREVENTS (4 confirmed live occurrences, most recently 2026-07-28T19:5xZ,
# commit 09ae11440): a BARE (pathspec-less) `git commit -m ...` commits WHATEVER is
# currently staged in the shared index, including a concurrent peer's `git add`'d WIP
# that landed after the committing actor's own last check — a snapshot-then-commit
# check (e.g. `git diff --cached --name-only` run as a separate script step before
# `git commit`) cannot close this: it is TOCTOU, a peer can `git add` in the gap.
#
# WHY A GIT HOOK: this control lives beneath the OS `git commit` invocation itself,
# so it binds the INV-GATEWAY-1-exempt population too (dev-*/qa/ba/pm/architect
# specialists never call the dispatcher's commit-mutex MCP skill by design — a git
# hook is transport-agnostic, so it structurally cannot be opted out of the way an
# MCP-bound skill can).
#
# DISCRIMINATOR ($GIT_INDEX_FILE basename — race-free, git-locked at hook time):
#   index | index.lock       -> BARE   (real, shared, persistent index; a peer's
#                                        `git add` could have landed in it moments ago)
#   next-index-<pid>.lock    -> SCOPED (git already resolved an explicit commit-line
#                                        pathspec into a private scratch index BEFORE
#                                        invoking this hook — structurally immune)
#   anything else            -> UNKNOWN (git-internal shape changed / unrecognized —
#                                        fail OPEN, never block on our own uncertainty,
#                                        but never silent either; mirrors commit-mutex's
#                                        own C-2/C-2b fail-open-but-loud precedent)
#
# DISPOSITION: WARN-by-default, fleet-wide, on day 1 — never blocks unless the caller
# has opted its OWN commit into GIT_SWEEP_GUARD_MODE=reject (only sensible once that
# call site's own commit line has migrated to pathspec form — see
# .claude/skills/commit-mutex/SKILL.md Step 3c for the reference migration). A
# hard-reject default would ALSO catch all 3 real occurrences, but would additionally
# block the majority of fleet commits day 1 (bare-commit-after-`git add` is still the
# dominant idiom across 60+ flow docs) — that is strictly worse than the silent-but-
# recoverable sweep bug it replaces. See brief §3 for the full trade-off writeup.
#
# ZERO required external dependencies for the GATING decision itself (no jq, no curl,
# no network — only git builtins + POSIX shell), so this can never become a new
# network-availability failure mode inside the commit hot path. `jq` is used ONLY for
# the best-effort docs/signals/ write (§ below), which is itself wrapped so its own
# failure can never affect the gating decision or block the commit.
#
# Install: ./scripts/git-hooks/install.sh  (symlinks into .git/hooks/, re-run on a
# fresh clone or a `.git` rebuild — .git/hooks is untracked).
# Bypass (NOT recommended, equivalent to --no-verify which is forbidden fleet-wide):
#   git commit --no-verify

set -u

# --- Resolve repo root (hooks run with CWD at the top of the working tree already,
#     per empirical verification in the owning brief §2.2 — but resolve explicitly
#     anyway so this hook does not silently depend on that undocumented behavior). ---
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  # Cannot even resolve the repo root inside a git hook — mechanism-broken, fail
  # OPEN + LOUD (never silently swallow, per AC-3 / commit-mutex C-2b precedent).
  echo "[sweep-guard] INTERNAL: could not resolve repo root via 'git rev-parse --show-toplevel' — fail-open" >&2
  exit 0
fi

LOG_FILE="$REPO_ROOT/.git/sweep-guard.log"
SIGNALS_DIR="$REPO_ROOT/docs/signals"
MARKER_FILE="$REPO_ROOT/.git/sweep-guard.pending"
# AC-1 (FIX-SWEEPGUARD-ESCALATION-RETROACTIVE-COUNTER-AND-SESSION-SCOPED-ACTOR):
# self-initializing per-clone deploy-baseline marker for the escalation counter
# below — see the block that reads/creates it for the full rationale.
BASELINE_FILE="$REPO_ROOT/.git/sweep-guard.escalation-baseline"

# --- Best-effort, never-blocking docs/signals/ bug-escalation write -----------------
# Shape matches the LIVE bug-escalation convention (verified against
# docs/signals/processed/news-scout-20260724T040000Z.json and
# docs/protocols/fail-loud-protocol.md § Output Boundary): {from,to,type,payload,
# priority,createdAt}. Zero MCP/network dependency — pure bash+jq, local file only.
write_signal() {
  msg="$1"
  command -v jq >/dev/null 2>&1 || return 0
  [ -d "$SIGNALS_DIR" ] || return 0
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || true)"
  [ -z "$ts" ] && return 0
  sig_file="$SIGNALS_DIR/commit-sweep-guard-$(printf '%s' "$ts" | tr -d ':')-$$.json"
  jq -n \
    --arg from "commit-sweep-guard" \
    --arg to "po" \
    --arg type "bug-escalation" \
    --arg priority "high" \
    --arg createdAt "$ts" \
    --arg payload "$msg" \
    '{from:$from, to:$to, type:$type, priority:$priority, createdAt:$createdAt, payload:$payload}' \
    > "$sig_file" 2>/dev/null || true
  return 0
}

# --- Auditor heartbeat sole-writer + shape guard (FIX-AUDITOR-HEARTBEAT-OUT-OF-
# CONTRACT-AGENT-WRITE-TIER1) -------------------------------------------------
# Independent of the sweep-guard mode dispatch below (runs first, on EVERY
# commit — BARE, SCOPED, or UNKNOWN — and is NEVER controlled by
# GIT_SWEEP_GUARD_MODE): a mis-shaped write to docs/data/auditor-tier{1,2,3}-
# last-healthy.json is an AUTHORIZATION/CORRECTNESS violation, not a "which
# actor's index got swept" question, so pathspec-scoping the commit does not
# exempt it. Root cause fixed: docs/agents/system-auditor/flow/main.md:748-755
# prose-gates the agent-side Tier-2/3 heartbeat write out of Tier-1
# ("Tier-1 is untouched") but a 2026-07-29T06:08:22Z cycle wrote the tier-1
# file anyway, collapsing it from {last_healthy_at, checks{6 keys}} to bare
# {last_healthy_at} on a DEGRADED cycle — a prose prohibition alone was
# insufficient (this was the SECOND observed violation of it), so this is now
# a hard code-level gate, not narration the model can skip.
#
# Full sole-writer + shape spec (cited from both writers — probe script header
# + system-auditor main.md): docs/policies/dev-standards.md
# CANONICAL:SSOT-AUDITOR-HEARTBEAT-SOLE-WRITER
#
#   docs/data/auditor-tier1-last-healthy.json — SOLE authorized writer is
#     scripts/agents-flow/auditor-tier1-probe.sh's _write_heartbeat() (only
#     reachable from run_probe()'s ALL_GREEN branch). Semantic: "system was
#     confirmed healthy". Shape MUST be {last_healthy_at, checks:{docker_ps,
#     health_3000, health_3001, disk, mem_creep, launchd_agents}} with ALL 6
#     values == "PASS" — that is the ONLY shape the authorized writer ever
#     produces, so any other shape (bare, missing keys, a non-PASS value) is
#     BY CONSTRUCTION an out-of-contract write and is rejected unconditionally.
#   docs/data/auditor-tier{2,3}-last-healthy.json — SOLE authorized writer is
#     the system-auditor subagent's own end-of-cycle write (main.md § Tier-2/3
#     Heartbeat Write, gated on AUDIT_TIER being 2/3). Semantic differs from
#     tier-1 BY DESIGN: "a real Tier-N audit cycle completed" (fires every
#     Tier-2/3 cycle regardless of HEALTHY/DEGRADED/CRITICAL — auditor-signal-
#     loop-P1, load-bearing for the SKIP-SPAWN freshness gate in
#     run_tiered_probe(); re-gating this on a green verdict would starve the
#     heartbeat on any persistently-tracked DEGRADED cycle and recreate the
#     exact spawn-storm the P1 fix closed — the mirror failure mode). Shape
#     MUST stay bare {last_healthy_at} — a "checks" key here means the tier-1
#     shape/semantic bled into a tier-2/3 marker, rejected the same way.
#
# jq-unavailable is a fail-OPEN + LOUD path (never a new commit-hot-path
# failure mode) — mirrors the sweep-guard's own UNKNOWN-shape precedent above.
_check_auditor_heartbeat_shapes() {
  local hb1="docs/data/auditor-tier1-last-healthy.json"
  local hb2="docs/data/auditor-tier2-last-healthy.json"
  local hb3="docs/data/auditor-tier3-last-healthy.json"
  local staged content msg f

  command -v jq >/dev/null 2>&1 || {
    echo "[heartbeat-guard] INTERNAL: jq unavailable — cannot verify auditor heartbeat shape, failing open (never block on our own uncertainty)" >&2
    return 0
  }

  staged="$(git diff --cached --name-status 2>/dev/null)" || return 0
  [ -z "$staged" ] && return 0

  # Tier-1 — skip on a staged DELETE ('D' status); only content-check add/modify.
  if printf '%s\n' "$staged" | grep -qE $'^[AM][[:space:]]'"$hb1"'$'; then
    content="$(git show ":$hb1" 2>/dev/null)"
    if [ -z "$content" ] || ! printf '%s' "$content" | jq -e '
        (.checks // empty) as $c
        | ($c | type) == "object"
        and (($c | keys | sort) == ["disk","docker_ps","health_3000","health_3001","launchd_agents","mem_creep"])
        and ([$c[]] | all(. == "PASS"))
        and ((.last_healthy_at // "") | length > 0)
      ' >/dev/null 2>&1; then
      msg="[heartbeat-guard] REJECT: ${hb1} staged content does not match the sole-writer shape (last_healthy_at + checks{6 keys, all PASS}). Only scripts/agents-flow/auditor-tier1-probe.sh's _write_heartbeat() on its ALL_GREEN branch is authorized to write this file — see docs/policies/dev-standards.md CANONICAL:SSOT-AUDITOR-HEARTBEAT-SOLE-WRITER. Commit BLOCKED — re-run the probe script for a genuine heartbeat instead of hand-writing this file."
      echo "$msg" >&2
      write_signal "$msg"
      return 1
    fi
  fi

  # Tier-2/3 — must stay bare; a "checks" key means the tier-1 shape bled in.
  for f in "$hb2" "$hb3"; do
    if printf '%s\n' "$staged" | grep -qE $'^[AM][[:space:]]'"$f"'$'; then
      content="$(git show ":$f" 2>/dev/null)"
      if [ -z "$content" ] || ! printf '%s' "$content" | jq -e '
          (has("checks") | not) and ((.last_healthy_at // "") | length > 0)
        ' >/dev/null 2>&1; then
        msg="[heartbeat-guard] REJECT: ${f} staged content must stay bare {last_healthy_at} — a tier-2/3 'audit completed' marker, never the tier-1 'checks{}' shape. See docs/policies/dev-standards.md CANONICAL:SSOT-AUDITOR-HEARTBEAT-SOLE-WRITER. Commit BLOCKED."
        echo "$msg" >&2
        write_signal "$msg"
        return 1
      fi
    fi
  done

  return 0
}

_check_auditor_heartbeat_shapes || exit 1

# --- Agent-notebook retained-section immutability guard (AC-2a) ---------------
# TASK: FIX-NOTEBOOK-COMPOSE-REWRITES-RETAINED-PRIOR-SECTIONS (docs/data/orch/
#       orch-state.json .task_board.backlog, P1). SPEC: .claude/skills/
#       notebook-write/SKILL.md § IMMUTABILITY INVARIANT (AC-2a).
# REPLAY/VALIDATION: scripts/audits/verify-notebook-immutability-gate.sh (run
#       this before trusting any future change to this gate — it replays the
#       real corpus history through the exact functions below, sourced
#       verbatim, not a reimplementation).
#
# BUG THIS PREVENTS: the notebook-write compose step lands its result as ONE
# whole-file Write/Edit, so authorized pruning (dropping a whole oldest '## '
# section) and unauthorized rewriting (silently compacting a RETAINED prior
# section's content to pay for an over-cap current section) are indistinguish-
# able in the resulting diff to any human/agent reviewer. MEASURED: commit
# 9b27e97236d2eeb26db5e18361b0f424d3b99c26 (docs/agent-memory/notebooks/
# system-auditor.md, 2026-07-29) rewrote FOUR retained sections in place
# (e.g. 25L -> 10L, dropping the "A-29 Cron Health Check" / "Freshness Sweep"
# / "Signals emitted" prose) on top of two whole-section drops, in the SAME
# settled write. Recurrence: >=5 of the last 12 system-auditor notebook
# commits per PO board measurement. Prose alone (the skill's own AC-2/AC-3
# wording) was already in place and did not hold — this is now a hard
# code-level gate, mirroring the heartbeat-shape guard above (same precedent:
# a mis-shaped/mis-content commit is an AUTHORIZATION violation, not a
# "which actor's index got swept" question, so it runs unconditionally here,
# independent of the sweep-guard mode dispatch below).
#
# FLEET-BLOCKING REGRESSION + FIX (2026-07-29, same day as landing): the first
# cut of this gate hard-rejected on ANY shared '## ' heading with a changed
# body hash, for every notebook except 3 hardcoded OVERWRITE-class files
# (po/market-watcher/orch-sentinel). Replay against the REAL corpus (all
# docs/agent-memory/notebooks/*.md, last ~8 commits each — see the replay
# script above) showed most of the fleet uses STABLE ROLLING headings that are
# DESIGNED to be rewritten every cycle and never carry a cycle-unique token
# (e.g. '## Working Memory', '## Current state', '## Known patterns /
# preferences', '## Carry-over', '## Active Sources Under Watch', '## Active
# Scrapers') — confirmed false-reject example: qa-responder.md's most recent
# notebook commit rejects on '## Current state' (HEAD hash 58d83af7b997...
# vs staged 3790c4cd679b...) even though that heading is intentionally
# rewritten every cycle, never dated. A hardcoded per-file exemption list is
# one new agent away from blocking the fleet again (it must enumerate every
# exception), so the mechanism now enumerates its SUBJECTS instead (fails
# safe): enforcement is opt-IN, scoped to headings that carry a recognizable
# cycle-unique date/timestamp token (_is_dated_heading below) — the AC-1
# convention this gate can actually reason about. A heading with no such
# token is, by construction, a rolling/stable section not designed for
# byte-identity and is skipped (never flagged), regardless of which file it
# lives in — this generalizes automatically to new agents/notebooks without
# needing a manually-maintained file allowlist. The 3 known OVERWRITE-class
# files are still skipped up front as a documented fast path (matches SKILL.md
# AC-6), though the date-heading scoping alone would already exempt their
# rolling headings.
#
# MECHANISM: for every staged docs/agent-memory/notebooks/*.md file (add/
# modify, APPEND-class only — the 3 OVERWRITE-class files intentionally
# replace their single section every cycle and are exempt by design), hash
# each '^## '-delimited section (heading line through the line before the
# next '## ' or EOF) on the HEAD side and on the staged side. Any heading
# text present on BOTH sides, carrying a dated/cycle-unique token
# (_is_dated_heading), with a DIFFERENT body hash means a retained section was
# mutated rather than dropped whole -> REJECT. A heading present only on HEAD
# (dropped whole), only on staged (the new cycle's section), or with no dated
# token at all (a rolling/stable heading, exempt by design) is never flagged.
#
# Zero new dependencies: git + shasum only (shasum ships with macOS/Darwin
# and virtually every Linux distro) — same "never a new commit-hot-path
# failure mode" bar as the sweep-guard discriminator above. Fails OPEN + LOUD
# (never blocks) on any file this mechanism cannot reason about: a brand-new
# file (nothing retained yet), a file with zero '^## ' boundaries in the HEAD
# content (a DIFFERENT, already-tracked defect —
# FIX-NOTEBOOK-PRUNE-HEADING-LEVEL-MISMATCH — this gate cannot section a file
# it cannot find headings in), or any git/shasum command failure.

_notebook_section_hashes() {
  # $1 = path to a plain-text file. Prints "heading<TAB>sha256hex" per
  # '^## '-delimited section found in that file. Prints nothing if the file
  # has zero '^## ' boundaries.
  local file="$1" total heading_lines start end heading hash i n
  local arr

  [ -s "$file" ] || return 0
  total="$(wc -l < "$file" 2>/dev/null | tr -d ' ')"
  [ -z "$total" ] && return 0

  heading_lines="$(grep -n '^## ' "$file" 2>/dev/null | cut -d: -f1)"
  [ -z "$heading_lines" ] && return 0

  arr=()
  while IFS= read -r ln; do
    [ -n "$ln" ] && arr+=("$ln")
  done <<HEADINGLINES
$heading_lines
HEADINGLINES

  n=${#arr[@]}
  for ((i = 0; i < n; i++)); do
    start="${arr[$i]}"
    if [ $((i + 1)) -lt "$n" ]; then
      end=$(( ${arr[$((i + 1))]} - 1 ))
    else
      end="$total"
    fi
    heading="$(sed -n "${start}p" "$file" 2>/dev/null)"
    # Trim trailing blank AND horizontal-rule ('---') lines before hashing: a
    # section's position (last-in-file vs followed-by-another-heading)
    # changes whether a trailing blank separator line, or a markdown '---'
    # divider an agent inserts between sections when APPENDING the NEXT
    # section, is captured in the PRECEDING section's slice — either would
    # otherwise produce a spurious hash mismatch for byte-identical retained
    # content that only gained trailing boilerplate (verified false-positive
    # cases: commit 01e50dbcbac6661b for the blank-line variant; corpus replay
    # 2026-07-29 via scripts/audits/verify-notebook-immutability-gate.sh
    # surfaced the '---' variant across every notebook using a '---' divider
    # convention, e.g. dev-pdf-extractor.md, qa-responder.md, dev-rag-service.md).
    hash="$(sed -n "${start},${end}p" "$file" 2>/dev/null | awk '{lines[NR]=$0; if ($0 != "" && $0 !~ /^-{3,}[[:space:]]*$/) last=NR} END{for (i=1;i<=last;i++) print lines[i]}' | shasum -a 256 2>/dev/null | awk '{print $1}')"
    [ -n "$heading" ] && [ -n "$hash" ] && printf '%s\t%s\n' "$heading" "$hash"
  done
}

_is_dated_heading() {
  # $1 = full heading line (e.g. "## c125 · 2026-07-28T21:12:42Z" or
  # "## Current state"). Returns 0 (true) iff the heading text embeds a
  # recognizable cycle-unique date/timestamp token — the AC-1 convention
  # (c<NNN>·ISO / bare ISO / "Session: <date>" / any heading carrying a real
  # calendar date) this gate can safely reason about. A heading with NO such
  # token is, by construction, a stable/rolling section (e.g. 'Working
  # Memory', 'Current state', 'Known patterns / preferences', 'Carry-over',
  # 'Active Sources Under Watch') that is intentionally rewritten every cycle
  # and is never flagged by _check_notebook_immutability below — this is the
  # opt-IN half of the AC-2a fleet-block fix (2026-07-29): enforcement is
  # scoped to recognized dated subjects rather than everything-except-a-
  # hardcoded-file-list, so a new agent/notebook with a rolling-heading
  # convention can never re-trigger the same fleet-wide false-reject.
  local heading="$1"
  # Dashed ISO date anywhere in the heading: YYYY-MM-DD.
  [[ "$heading" =~ [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] ]] && return 0
  # Compact ISO date+time anywhere in the heading: YYYYMMDDTHHMM (main.md's
  # 'cycle-20260729T0837Z' style headings use this form, no dashes).
  [[ "$heading" =~ [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9] ]] && return 0
  return 1
}

_check_notebook_immutability() {
  local staged nb_files f old_tmp new_tmp old_hashes new_hashes rc all_msgs mode_nb verdict_word
  local overwrite1="docs/agent-memory/notebooks/po.md"
  local overwrite2="docs/agent-memory/notebooks/market-watcher.md"
  local overwrite3="docs/agent-memory/notebooks/orch-sentinel.md"

  # DISARMED-BY-DEFAULT (2026-07-29, same day as the dated-heading fix above):
  # corpus replay (scripts/audits/verify-notebook-immutability-gate.sh) found
  # the dated-heading scoping fix, while correct and kept, is NOT sufficient
  # for a zero-false-reject hard gate — two FURTHER false-positive classes
  # remain, neither fixable by heading-text classification: (1) some notebooks
  # (e.g. dev-frontend.md) keep a rolling status footer with NO '## ' heading
  # of its own, so it gets silently absorbed into whichever DATED heading is
  # currently last-in-file, and is legitimately rewritten every cycle — this
  # gate cannot tell that apart from the real bug; (2) periodic BULK
  # archival/maintenance restructuring commits (e.g. qa-responder.md's
  # d5c78d459451 "notebook archival + YELLOW fixes" sweep, a claude-manager-
  # helper memory-prune-sweep, not a routine per-cycle notebook-write) are
  # AUTHORIZED to regenerate/condense old dated summaries and legitimately
  # collide on heading text with different content — this gate cannot
  # distinguish "routine per-cycle write silently mutated a retained section"
  # from "authorized archival sweep intentionally recomputed one". Per the
  # owning row's explicit contingency ("if you cannot get the opt-in
  # classification correct and validated this run, disarm the gate"): mirrors
  # the sweep-guard's OWN WARN-by-default/opt-in-reject precedent immediately
  # below — never blocks a commit unless a caller explicitly opts in via
  # GIT_NOTEBOOK_IMMUTABILITY_MODE=reject (not recommended fleet-wide until
  # both classes above are closed and re-validated via the replay script).
  # All detection/hashing logic stays live and loud (stderr + one aggregated
  # docs/signals/ write per commit) so real violations are still visible —
  # only the hard block is gated off.
  mode_nb="${GIT_NOTEBOOK_IMMUTABILITY_MODE:-warn}"

  command -v shasum >/dev/null 2>&1 || {
    echo "[notebook-immutability-guard] INTERNAL: shasum unavailable — cannot verify retained-section immutability, failing open (never block on our own uncertainty)" >&2
    return 0
  }

  staged="$(git diff --cached --name-status 2>/dev/null)" || return 0
  [ -z "$staged" ] && return 0

  nb_files="$(printf '%s\n' "$staged" | awk '$1 ~ /^[AM]$/ && $2 ~ /^docs\/agent-memory\/notebooks\/.*\.md$/ {print $2}')"
  [ -z "$nb_files" ] && return 0

  rc=0
  all_msgs=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    [ "$f" = "$overwrite1" ] && continue
    [ "$f" = "$overwrite2" ] && continue
    [ "$f" = "$overwrite3" ] && continue

    old_tmp="$(mktemp "${TMPDIR:-/tmp}/nb-immut-old.XXXXXX" 2>/dev/null)" || continue
    new_tmp="$(mktemp "${TMPDIR:-/tmp}/nb-immut-new.XXXXXX" 2>/dev/null)" || { rm -f "$old_tmp"; continue; }

    if ! git show "HEAD:$f" > "$old_tmp" 2>/dev/null; then
      rm -f "$old_tmp" "$new_tmp"; continue   # new file this commit — nothing retained yet
    fi
    if ! git show ":$f" > "$new_tmp" 2>/dev/null; then
      rm -f "$old_tmp" "$new_tmp"; continue
    fi

    old_hashes="$(_notebook_section_hashes "$old_tmp")"
    if [ -z "$old_hashes" ]; then
      rm -f "$old_tmp" "$new_tmp"; continue   # no '## ' boundaries on HEAD side — different defect, fail open
    fi

    # Compute the staged side's section hashes ONCE per file (was previously
    # recomputed — full sed+shasum pass — inside every iteration of the loop
    # below, an O(headings_old * headings_new) subprocess cost). Reused via
    # cheap per-heading awk lookups against this pre-computed string instead.
    new_hashes="$(_notebook_section_hashes "$new_tmp")"

    while IFS=$'\t' read -r heading old_hash; do
      [ -z "$heading" ] && continue
      _is_dated_heading "$heading" || continue   # rolling/stable heading — exempt by design, never flagged
      # Look up this exact heading in the NEW file's own hash table (not a
      # plain grep line match — headings could in theory repeat) to get its
      # staged-side content hash, if that heading still exists there at all.
      new_hash="$(printf '%s\n' "$new_hashes" | awk -F'\t' -v h="$heading" '$1==h{print $2; exit}')"
      if [ -n "$new_hash" ] && [ "$new_hash" != "$old_hash" ]; then
        verdict_word="WARN"
        [ "$mode_nb" = "reject" ] && verdict_word="REJECT"
        msg="[notebook-immutability-guard] ${verdict_word}: ${f} — retained section '${heading}' has different content staged than at HEAD. Per .claude/skills/notebook-write/SKILL.md AC-2a, a retained '## ' section must be byte-identical across a cycle; the only authorized mutations are dropping a whole oldest section, the AC-2b sub-block intra-prune, or trimming the CURRENT cycle's own new section. If cap pressure forced a shrink, DROP the whole section (archive verbatim if it must be kept) and add a NEW marker section instead — see docs/agent-memory/notebooks/architect.md for the reference-correct pattern. mode=${mode_nb} (default warn — never blocks; set GIT_NOTEBOOK_IMMUTABILITY_MODE=reject to hard-enforce once re-validated, see scripts/audits/verify-notebook-immutability-gate.sh)."
        echo "$msg" >&2
        all_msgs="${all_msgs}${msg}
"
        rc=1
      fi
    done <<OLDHASHES
$old_hashes
OLDHASHES

    rm -f "$old_tmp" "$new_tmp"
  done <<NBFILES
