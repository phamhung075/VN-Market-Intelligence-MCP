# PROVENANCE_MODE defaults to 'warn') — mirrors GIT_NOTEBOOK_IMMUTABILITY_MODE
# immediately above, same rationale: this is a NEW gate on a corpus not yet
# proven zero-false-positive end-to-end (Rule 2 in particular is ambiguous by
# construction). Rule 1 CAN be hard-enforced by setting mode=reject once a
# caller has verified no legitimate full-UUID-on-heading-line convention
# (e.g. tran-ngoc-bau's own collision-note pattern) is still in active use.
# Rule 2 never hard-blocks regardless of mode — see its own note above.
#
# PURE CLASSIFIER (no git/env access — sourced verbatim by scripts/audits/
# verify-notebook-uuid-provenance-gate.sh, same "never reimplement" bar as
# _is_dated_heading above). $1 = one heading line, ALREADY STRIPPED of any
# leading diff '+' marker (i.e. starts with '## '). Prints one of:
#   RULE1<TAB><line>   — full UUID anywhere on the line
#   RULE2<TAB><token>  — bare 6-8 hex first-token (ambiguous)
#   (nothing)          — clean, or escape-hatched
# Prints at most one verdict per line (RULE1 takes priority; a line matching
# both is only ever the RULE1 case in practice since a full UUID's first
# segment is 8 hex chars immediately followed by a hyphen, which already
# fails RULE2's "nothing else" containment on the token boundary above).
_notebook_uuid_line_verdict() {
  local line="$1" token
  local full_uuid_re='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'

  [[ "$line" == *"notebook-uuid-lint-allow:"* ]] && return 0

  if [[ "$line" =~ $full_uuid_re ]]; then
    printf 'RULE1\t%s\n' "$line"
    return 0
  fi

  token="$(printf '%s\n' "$line" | sed -E 's/^## ([^[:space:]]+).*/\1/')"
