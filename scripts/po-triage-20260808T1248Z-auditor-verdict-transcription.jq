  created_by: "po/triage-20260808T1248Z-auditor-verdict-transcription",
  source: "router-RAW-verified-2026-08-08T12:37Z (agent aff06d43ca294abf8) + memory feedback_a30_prose_overrides_embedded_escalate_verdict",
  files: [
    "scripts/audit-output-contract.sh",
